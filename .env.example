# Copy to .env and fill in. `.env` is gitignored — never commit real keys.
#
# The external "worker" model that scripts/delegate.py hands specs to.
# Any OpenAI-compatible /chat/completions endpoint works.

# Base URL, without a trailing /chat/completions.
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Together:    https://api.together.xyz/v1
#   local:       http://localhost:11434/v1
WORKER_API_BASE=https://api.openai.com/v1

# The worker model id, exactly as that provider spells it. Check the
# provider's model list — do not guess the string.
WORKER_MODEL=

# Bearer token for the endpoint above.
WORKER_API_KEY=

# Output cap per delegation. Raise if the worker truncates mid-file.
WORKER_MAX_TOKENS=16000
